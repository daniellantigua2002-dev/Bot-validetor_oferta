# Clave de NVIDIA Build (https://build.nvidia.com). Modelo de visión de respaldo final:
# entra solo cuando se agota la cuota de todas las claves de Gemini. Tiene límites generosos.
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it

# IA principal: claves gratuitas de Google AI Studio (https://aistudio.google.com/apikey).
# Una o varias claves separadas por coma, UNA POR CUENTA de Google (cada cuenta tiene sus 20 peticiones/día).
# El bot las rota en orden y salta a la siguiente cuando una se queda sin cuota del día. Vacía = sin Gemini.
GEMINI_API_KEY=clave_cuenta_1,clave_cuenta_2,clave_cuenta_3
# Uno o varios modelos separados por coma (si uno está saturado o sin cuota entra el siguiente)
GEMINI_MODEL=gemini-3.5-flash

# Token del bot de Telegram (@BotFather) y usuarios autorizados en privado, separados por coma
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# Grupos donde cualquier miembro puede usar el bot (el ID aparece en la ventana del bot al agregarlo)
ALLOWED_CHAT_IDS=
