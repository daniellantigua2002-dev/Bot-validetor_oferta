# Clave de NVIDIA Build (https://build.nvidia.com) para el modelo de visión
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
# Modelo que se usa si el principal falla (vacío = sin respaldo)
NVIDIA_MODEL_RESPALDO=meta/llama-3.2-90b-vision-instruct

# Segunda IA de respaldo: clave gratuita de Google AI Studio (https://aistudio.google.com/apikey).
# Se usa si NVIDIA falla o tarda más de 30 s. Vacía = sin Gemini.
GEMINI_API_KEY=
# Uno o varios modelos separados por coma (si uno está saturado entra el siguiente)
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash

# Token del bot de Telegram (@BotFather) y usuarios autorizados en privado, separados por coma
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# Grupos donde cualquier miembro puede usar el bot (el ID aparece en la ventana del bot al agregarlo)
ALLOWED_CHAT_IDS=
