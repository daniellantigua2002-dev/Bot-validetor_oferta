{
  "name": "bot-validador-spei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot que valida comprobantes SPEI contra el CEP de Banxico",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "validar": "tsx src/cli.ts",
    "explorar": "tsx scripts/explorar-cep.ts",
    "extraer": "tsx scripts/probar-extraccion.ts",
    "probar-imagenes": "tsx scripts/probar-imagenes.ts",
    "comparar-modelos": "tsx scripts/comparar-modelos.ts",
    "bot": "tsx src/index.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.6",
    "grammy": "^1.46.0",
    "openai": "^7.31.0",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
